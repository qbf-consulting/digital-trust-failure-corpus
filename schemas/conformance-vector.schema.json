{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DTFC experimental paired conformance vector v0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vector_version",
    "case_id",
    "case_version",
    "execution_class",
    "adapter",
    "request",
    "expected_safe",
    "expected_defective",
    "targets",
    "target_git_blob_sha1"
  ],
  "properties": {
    "vector_version": {
      "const": "0.2.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^DTF-[0-9]{3}$"
    },
    "case_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "execution_class": {
      "const": "executed-synthetic-target"
    },
    "adapter": {
      "const": "python-subprocess-v1"
    },
    "request": {
      "type": "object",
      "minProperties": 1
    },
    "expected_safe": {
      "$ref": "#/$defs/dispositions"
    },
    "expected_defective": {
      "$ref": "#/$defs/dispositions"
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safe",
        "defective"
      ],
      "properties": {
        "safe": {
          "enum": [
            "examples/independent-consumer/authority_target.py",
            "examples/independent-consumer/defective_authority_target.py",
            "examples/independent-consumer/composition_target.py",
            "examples/independent-consumer/defective_composition_target.py",
            "examples/independent-consumer/workflow_assurance_target.py",
            "examples/independent-consumer/defective_workflow_assurance_target.py"
          ]
        },
        "defective": {
          "enum": [
            "examples/independent-consumer/authority_target.py",
            "examples/independent-consumer/defective_authority_target.py",
            "examples/independent-consumer/composition_target.py",
            "examples/independent-consumer/defective_composition_target.py",
            "examples/independent-consumer/workflow_assurance_target.py",
            "examples/independent-consumer/defective_workflow_assurance_target.py"
          ]
        }
      }
    },
    "target_git_blob_sha1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safe",
        "defective"
      ],
      "properties": {
        "safe": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "defective": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    }
  },
  "$defs": {
    "dispositions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PASS",
          "DENY",
          "INDETERMINATE"
        ]
      }
    }
  }
}
