{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DTFC Portable Execution Binding 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_version",
    "case_id",
    "case_version",
    "adapter",
    "scenario",
    "expected",
    "observed",
    "evidence",
    "case_sha256"
  ],
  "properties": {
    "binding_version": {
      "const": "0.2.0"
    },
    "case_id": {
      "pattern": "^DTF-[0-9]{3,}$",
      "type": "string"
    },
    "case_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "adapter": {
      "const": "fixture-v1"
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "type": "string",
      "enum": [
        "DENY",
        "INDETERMINATE"
      ]
    },
    "observed": {
      "type": "string",
      "enum": [
        "PASS",
        "DENY",
        "INDETERMINATE"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "case_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
