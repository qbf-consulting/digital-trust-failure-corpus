{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DTFC Portable Execution Result 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_version",
    "case_id",
    "case_version",
    "scenario",
    "target_disposition",
    "test_verdict",
    "evidence",
    "case_sha256",
    "adapter",
    "execution_class"
  ],
  "properties": {
    "binding_version": {
      "const": "0.2.0"
    },
    "case_id": {
      "type": "string"
    },
    "case_version": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "target_disposition": {
      "enum": [
        "PASS",
        "DENY",
        "INDETERMINATE"
      ]
    },
    "test_verdict": {
      "enum": [
        "SATISFIED",
        "VIOLATED"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "case_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "adapter": {
      "const": "fixture-v1"
    },
    "execution_class": {
      "const": "author-supplied-fixture"
    }
  }
}
