{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External source crosswalk research record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_date",
    "scope",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "source_id",
          "url",
          "kind",
          "case_ids",
          "disposition",
          "confidence",
          "rationale",
          "reuse"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\\\s]+$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "case_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^DTF-[0-9]{3,}$"
            }
          },
          "disposition": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "reuse": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
